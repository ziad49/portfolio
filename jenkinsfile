pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Frontend - Install') {
      steps {
        bat 'npm ci'
      }
    }

    stage('Frontend - Tests') {
      steps {
        
        bat 'set JEST_JUNIT_OUTPUT_DIR=reports/junit&& set JEST_JUNIT_OUTPUT_NAME=junit.xml&& npm run test:ci'
      }
    }

    stage('Backend - Install') {
      steps {
        bat 'cd server && npm ci'
      }
    }

    stage('Backend - Tests') {
      steps {
       
        bat 'cd server && npm test'
      }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: 'reports/junit/*.xml, server/reports/junit/*.xml'
      archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/junit/*.xml, server/reports/junit/*.xml'
    }
  }
}
