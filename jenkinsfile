pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Unit Tests') {
            steps {
                bat 'npm run test:ci'
            }
        }

    }

    post {
        always {
            junit 'reports/junit/*.xml'
        }
    }
}
