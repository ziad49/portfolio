pipeline {
  agent any

  environment {
    // Frontend
    FRONTEND_JUNIT_DIR = "reports/junit"
    FRONTEND_JUNIT_FILE = "junit.xml"

    // Backend
    BACKEND_JUNIT_DIR = "server/reports/junit"
    BACKEND_JUNIT_FILE = "junit.xml"
  }

  stages {

    /* ==========================
       FRONTEND
       ========================== */

    stage('Frontend - Install') {
      steps {
        bat 'npm ci'
      }
    }

    stage('Frontend - Tests') {
      steps {
        bat '''
          set CI=true
          set JEST_JUNIT_OUTPUT_DIR=%FRONTEND_JUNIT_DIR%
          set JEST_JUNIT_OUTPUT_NAME=%FRONTEND_JUNIT_FILE%
          npm test -- --watchAll=false --runTestsByPath src/App.test.js --testResultsProcessor=jest-junit
        '''
      }
    }

    /* ==========================
       BACKEND
       ========================== */

    stage('Backend - Install') {
      steps {
        dir('server') {
          bat 'npm ci'
        }
      }
    }

    stage('Backend - Tests') {
      steps {
        dir('server') {
          bat '''
            set JEST_JUNIT_OUTPUT_DIR=reports/junit
            set JEST_JUNIT_OUTPUT_NAME=junit.xml
            npm test
          '''
        }
      }
    }
  }

  post {
    always {
      // Rapports Frontend
      junit allowEmptyResults: true, testResults: 'reports/junit/junit.xml'

      // Rapports Backend
      junit allowEmptyResults: true, testResults: 'server/reports/junit/junit.xml'
    }

    success {
      echo 'Pipeline terminé avec succès'
    }

    failure {
      echo 'Échec du pipeline'
    }
  }
}
