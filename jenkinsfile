pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Debug path') {
      steps {
        bat '''
        echo ===== ROOT CONTENT =====
        dir
        echo ===== IF SRC EXISTS HERE =====
        if exist src (echo SRC FOUND) else (echo SRC NOT FOUND)
        '''
      }
    }

    stage('Frontend - Install + Tests') {
      steps {
        dir('.') {
          bat '''
          echo ===== INSIDE PROJECT DIR =====
          cd
          dir
          dir src

          npm ci

          set JEST_JUNIT_OUTPUT_DIR=reports/junit
          set JEST_JUNIT_OUTPUT_NAME=junit.xml

          set CI=true&& react-scripts test --watchAll=false --testResultsProcessor=jest-junit
          '''
        }
      }
    }

    stage('Backend - Install + Tests') {
      steps {
        dir('server') {
          bat '''
          echo ===== INSIDE SERVER DIR =====
          cd
          dir

          npm ci

          set JEST_JUNIT_OUTPUT_DIR=reports/junit
          set JEST_JUNIT_OUTPUT_NAME=junit.xml

          npm test
          '''
        }
      }
    }
  }

  post {
    always {
      // Frontend JUnit
      junit allowEmptyResults: true, testResults: 'reports/junit/*.xml'
      // Backend JUnit
      junit allowEmptyResults: true, testResults: 'server/reports/junit/*.xml'
      // Optionnel: archive des rapports
      archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/junit/*.xml, server/reports/junit/*.xml'
    }
  }
}
